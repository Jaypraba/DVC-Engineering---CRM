# ─────────────────────────────────────────────────────────────────────────────
# DVC Engineering Lead Generation Pipeline — Environment Variables
#
# Copy this file to .env in the lead_gen/ directory and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Planning London Datahub ───────────────────────────────────────────────────
# Request a key: GET https://api.planning.org.uk/v1/generatekey?email=jesan@dvceng.com
PLANNING_API_KEY=

# Header name to use when calling the PLD API (default: Authorization)
# Some PLD configurations use a custom header, e.g. "x-api-key"
PLD_API_HEADER=Authorization

# ── Companies House ───────────────────────────────────────────────────────────
# Register at: https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=

# ── Anthropic (outreach email generation) ────────────────────────────────────
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── Attio CRM (optional lead push) ───────────────────────────────────────────
# Get key at: https://app.attio.com/settings/api
# Leave blank to skip Attio push
ATTIO_API_KEY=

# ── ClickUp (optional lead push) ─────────────────────────────────────────────
# Get key at: https://app.clickup.com/settings/apps
# CLICKUP_LIST_ID: the numeric ID of the ClickUp list to create tasks in
# Leave both blank to skip ClickUp push
CLICKUP_API_KEY=
CLICKUP_LIST_ID=
