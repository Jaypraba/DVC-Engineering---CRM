# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Resend Email
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=crm@dvceng.com

# Anthropic AI
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Microsoft Graph (O365 Calendar)
MS_TENANT_ID=your-azure-tenant-id
MS_CLIENT_ID=your-azure-client-id
MS_CLIENT_SECRET=your-azure-client-secret

# Amadeus (Travel Deals Finder) — free keys at developers.amadeus.com
AMADEUS_CLIENT_ID=your-amadeus-client-id
AMADEUS_CLIENT_SECRET=your-amadeus-client-secret
# Set to "production" once you have live keys; defaults to the free test sandbox
AMADEUS_ENV=test

# Planning APIs
PLD_API_HEADER=your-pld-api-header-value
PLANNING_API_KEY=your-planning-api-key

# Internal
DIRECTOR_EMAIL=jesan@dvceng.com
CRON_SECRET=your-cron-secret-min-32-chars

# App
NEXT_PUBLIC_APP_URL=https://crm.dvceng.com
# Must match exactly what's registered in Azure as redirect URI:
# https://crm.dvceng.com/api/auth/microsoft/callback
NODE_ENV=production
