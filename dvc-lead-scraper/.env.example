# Supabase (your existing DVC CRM project)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=service_role_or_anon_key

# Resend (for the daily digest email)
RESEND_API_KEY=re_xxxxxxxxxxxx
LEAD_EMAIL_TO=hello@dvceng.com
LEAD_EMAIL_FROM=leads@dvceng.com

# Google Programmable Search Engine (free tier: 100 queries/day)
# Set up at https://programmablesearchengine.google.com/ (search the entire web,
# no site restriction needed, we build site: filters in the query itself)
# API key from https://console.cloud.google.com/apis/credentials
GOOGLE_CSE_API_KEY=xxxxxxxxxxxx
GOOGLE_CSE_CX=xxxxxxxxxxxx

# Set to "true" to bypass the 3pm London-time gate for local testing
FORCE_RUN=true
