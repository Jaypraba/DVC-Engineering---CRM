# Public site URL, used for metadata, sitemap and canonical links.
NEXT_PUBLIC_SITE_URL=https://100mm.co.uk

# Stripe. Without these, /book renders but checkout returns a clear 503 rather
# than failing the build.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Set to "true" to let Stripe Tax add VAT at checkout. Prices on the site are
# quoted excluding VAT either way.
STRIPE_AUTOMATIC_TAX=false

# The site visit fee, in pence, excluding VAT. Defaults to 95000 (£950).
SITE_VISIT_PRICE_PENCE=95000
